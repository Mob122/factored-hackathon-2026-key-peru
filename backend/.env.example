# Copie este archivo a backend/.env y cambie los valores. backend/.env está en .gitignore.
# El backend no arranca si falta SECRET_KEY, CARD_HASH_KEY o AUDIT_KEY (POL-AUTH-10).

# "development" habilita el registro abierto y la creación de tablas al arrancar. Si falta, el registro queda cerrado.
ENV=development
DATABASE_URL=sqlite:///./key_peru.db

# Firma de los JWT de sesión. Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256

# HMAC de números de tarjeta: debe ser la misma clave que usó el pipeline gold (ml/conf/local/credentials.yml).
CARD_HASH_KEY=change-me
# Seudónimos del audit log (docs/contracts/audit_log.md, AL-P3). Distinta de las demás claves.
AUDIT_KEY=change-me

# Contraseña de los usuarios de prueba que crea scripts/sembrar_usuarios.py (al menos 12 caracteres).
SEED_PASSWORD=change-me-at-least-12

# Carpeta con las tablas gold (o su carpeta padre 03_primary).
GOLD_DIR=../ml/data/03_primary/gold
# Reloj simulado del banco para ventanas de transacciones y eventos del overlay (opcional).
# Las conversaciones golden y la evaluación usan 2026-06-18. Sin valor, se usa la hora real.
# RELOJ_SIMULADO=2026-06-18T10:00:00

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_ALLOWED_MODELS=gpt-4o-mini
OPENAI_API_KEY=change-me
